# Replace with production configuration. Use a TLS reverse proxy in front of port 4080.
POSTGRES_PASSWORD=replace-with-production-password
FRONTEND_PORT=4080
APP_PUBLIC_URL=https://office.example.com
# Local IDE/Maven debug requires an explicitly authorized production database connection.
DATABASE_URL=jdbc:postgresql://localhost:5432/legaldesk_prod
DATABASE_USERNAME=legaldesk
DATABASE_PASSWORD=replace-with-production-password
PORT=8083
SESSION_COOKIE_SECURE=true
# Initial office owner: used only when the database has no users.
BOOTSTRAP_OWNER_NATIONAL_ID=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PHONE=
BOOTSTRAP_OWNER_PASSWORD=
