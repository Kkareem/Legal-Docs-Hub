{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Maven build dev",
      "type": "shell",
      "command": "mvn",
      "args": [
        "-Pdev",
        "-pl",
        "legaldesk-app",
        "-am",
        "package",
        "-DskipTests"
      ],
      "options": {
